#!/usr/bin/env bash
# =============================================================================
# foreman — pre-push hook
# Runs before any `git push`. Does four things:
#   1. Blocks direct pushes to main/master/production/prod
#   2. Warns on non-compliant branch names by default
#   3. Runs whatever test/lint/build gates exist in the repo
#   4. Runs the Phase 2 reviewer as a soft gate unless FOREMAN_HARD_GATE=1
#
# Smart detection: looks for Python (pytest, ruff, mypy), Node (npm test/lint/build),
# and Makefile targets. Skips checks cleanly if those tools aren't present.
#
# Gate failure blocks the push. Reviewer BLOCKER verdicts stay advisory unless
# FOREMAN_HARD_GATE=1 is set in the environment.
# To bypass in a genuine emergency: git push --no-verify
# Install: hooks/install.sh copies this to .git/hooks/pre-push and chmod +x
# =============================================================================

set -euo pipefail

REMOTE="$1"
# URL="$2"  # available if needed
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "🔍  foreman pre-push gate"
echo "    Branch: $CURRENT_BRANCH → $REMOTE"
echo ""

# ── Block direct push to protected branches ───────────────────────────────────
PROTECTED_BRANCHES=("main" "master" "production" "prod")
for protected in "${PROTECTED_BRANCHES[@]}"; do
  if [[ "$CURRENT_BRANCH" == "$protected" ]]; then
    echo "❌  foreman: direct push to '$CURRENT_BRANCH' is not allowed."
    echo ""
    echo "    Open a PR from an agent branch instead:"
    echo "      agent/<tool>/<YYYY-MM-DD>/<slug>"
    echo ""
    echo "    If you genuinely need to push directly: git push --no-verify"
    echo ""
    exit 1
  fi
done

# ── Warn on non-compliant branch names ────────────────────────────────────────
BRANCH_PATTERN='^(agent|review)/[a-z0-9_-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-z0-9-]+$'
if [[ ! "$CURRENT_BRANCH" =~ $BRANCH_PATTERN ]]; then
  echo "⚠️  foreman: branch name does not follow the required convention."
  echo "Expected: agent/<tool>/<YYYY-MM-DD>/<slug> or review/<tool>/<YYYY-MM-DD>/<slug>"
  echo "Got:      $CURRENT_BRANCH"
  if [[ "${FOREMAN_STRICT_BRANCH:-}" == "1" ]]; then
    echo "FOREMAN_STRICT_BRANCH=1 is set, so push is blocked."
    echo ""
    exit 1
  fi
  echo "Push proceeding — fix branch name before opening a PR."
  echo ""
fi

# ── Gate runner ───────────────────────────────────────────────────────────────
GATE_PASSED=true
RESULTS=()

run_gate() {
  local name="$1"
  local cmd="$2"
  local output
  echo "    ▸ $name ..."
  if output=$(eval "$cmd" 2>&1); then
    RESULTS+=("  ✅  $name")
  else
    RESULTS+=("  ❌  $name — FAILED")
    GATE_PASSED=false
    echo ""
    echo "$output" | head -40
    echo ""
  fi
}

skip_gate() {
  local name="$1"
  local reason="$2"
  RESULTS+=("  ⏭️   $name (skipped: $reason)")
}

PYTHON_BIN=""
if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
fi

resolve_review_base_ref() {
  if [[ -n "${FOREMAN_REVIEW_BASE_REF:-}" ]]; then
    if git rev-parse --verify --quiet "${FOREMAN_REVIEW_BASE_REF}^{commit}" >/dev/null; then
      printf '%s\n' "$FOREMAN_REVIEW_BASE_REF"
      return 0
    fi
    return 1
  fi

  if git show-ref --verify --quiet "refs/remotes/origin/main"; then
    printf '%s\n' "origin/main"
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/main"; then
    printf '%s\n' "main"
    return 0
  fi

  return 1
}

model_family() {
  local model_value
  model_value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$model_value" in
    *claude*)
      printf '%s\n' "claude"
      ;;
    *codex*)
      printf '%s\n' "codex"
      ;;
    gpt*|*gpt*|o1*|o3*|o4*|*openai*)
      printf '%s\n' "gpt"
      ;;
    *)
      printf '%s\n' "unknown"
      ;;
  esac
}

# ── Python gates ──────────────────────────────────────────────────────────────
if [ -f "pyproject.toml" ] || [ -f "setup.py" ] || [ -f "setup.cfg" ] || [ -f "requirements.txt" ]; then
  # pytest
  if [[ -n "$PYTHON_BIN" ]] && ("$PYTHON_BIN" -m pytest --version >/dev/null 2>&1 || command -v pytest >/dev/null 2>&1); then
    run_gate "pytest" "$PYTHON_BIN -m pytest --tb=short -q 2>&1"
  else
    skip_gate "pytest" "python/pytest not installed"
  fi

  # ruff
  if [[ -n "$PYTHON_BIN" ]] && ("$PYTHON_BIN" -m ruff --version >/dev/null 2>&1 || command -v ruff >/dev/null 2>&1); then
    run_gate "ruff (lint)" "$PYTHON_BIN -m ruff check . 2>&1"
  else
    skip_gate "ruff" "python/ruff not installed"
  fi

  # mypy (optional — only run if mypy config exists)
  if [ -f "mypy.ini" ] || grep -q "\[tool.mypy\]" pyproject.toml 2>/dev/null; then
    if [[ -n "$PYTHON_BIN" ]] && ("$PYTHON_BIN" -m mypy --version >/dev/null 2>&1 || command -v mypy >/dev/null 2>&1); then
      run_gate "mypy (types)" "$PYTHON_BIN -m mypy . --ignore-missing-imports 2>&1"
    else
      skip_gate "mypy" "python/mypy not installed"
    fi
  fi
fi

# ── Node / TypeScript gates ───────────────────────────────────────────────────
if [ -f "package.json" ]; then
  # npm test
  if node -e "require('./package.json').scripts?.test" &>/dev/null 2>&1; then
    run_gate "npm test" "npm test --if-present 2>&1"
  else
    skip_gate "npm test" "no test script in package.json"
  fi

  # npm lint
  if node -e "const s=require('./package.json').scripts; if(!s||!s.lint) process.exit(1)" 2>/dev/null; then
    run_gate "npm lint" "npm run lint 2>&1"
  else
    skip_gate "npm lint" "no lint script in package.json"
  fi

  # npm build (only if there's a build script and we're not in dev-only mode)
  if node -e "const s=require('./package.json').scripts; if(!s||!s.build) process.exit(1)" 2>/dev/null; then
    run_gate "npm build" "npm run build 2>&1"
  else
    skip_gate "npm build" "no build script in package.json"
  fi
fi

# ── Makefile gates ────────────────────────────────────────────────────────────
if [ -f "Makefile" ]; then
  if make -n test &>/dev/null 2>&1; then
    run_gate "make test" "make test 2>&1"
  fi
fi

# ── Results ───────────────────────────────────────────────────────────────────
echo ""
echo "    Gate results:"
if [ "${#RESULTS[@]}" -gt 0 ]; then
  for line in "${RESULTS[@]}"; do
    echo "  $line"
  done
fi
echo ""

if [ "$GATE_PASSED" = false ]; then
  echo "❌  foreman: gate failed — push blocked."
  echo "    Fix the failures above, then try again."
  echo "    To bypass in a genuine emergency: git push --no-verify"
  echo ""
  exit 1
fi

# ── Warn if no gates actually ran ─────────────────────────────────────────────
REAL_GATES=0
if [ "${#RESULTS[@]}" -gt 0 ]; then
  REAL_GATES="$(printf '%s\n' "${RESULTS[@]}" | awk '/✅|❌/ {count++} END {print count+0}')"
fi
if [ "$REAL_GATES" -eq 0 ]; then
  echo "⚠️   foreman: no gates ran — no test/lint/build tools detected."
  echo "    Consider adding tests. Push proceeding, but this branch has no"
  echo "    external verification. See AGENTS.md §3 for merge conditions."
  echo ""
fi

# ── Commit trailer validation ────────────────────────────────────────────────
REVIEWER_SCRIPT="$REPO_ROOT/scripts/foreman-review.py"
REVIEW_JSON_PATH="$REPO_ROOT/.agent-runs/last-review.json"
REVIEW_BASE_REF="$(resolve_review_base_ref || true)"
REVIEW_DIFF=""

if [[ -z "$REVIEW_BASE_REF" ]]; then
  echo "Trailer validation: skipped (unable to resolve diff base; tried main and origin/main)"
else
  REQUIRED_TRAILERS=("Agent" "Thread" "Task" "Verified-By")
  TRAILER_ERRORS=()

  while IFS= read -r commit_hash; do
    commit_msg="$(git log -1 --format=%B "$commit_hash")"
    commit_subject="$(git log -1 --format=%s "$commit_hash")"

    if [[ "$commit_subject" =~ ^Merge\ |^fixup\!|^squash\!|^WIP|^wip ]]; then
      continue
    fi

    for trailer in "${REQUIRED_TRAILERS[@]}"; do
      if ! grep -qiE "^${trailer}:[[:space:]].+" <<<"$commit_msg"; then
        TRAILER_ERRORS+=("  ❌  commit ${commit_hash:0:7}: missing '$trailer:' trailer")
      fi
    done
  done < <(git log "${REVIEW_BASE_REF}"..HEAD --format=%H)

  if [ ${#TRAILER_ERRORS[@]} -gt 0 ]; then
    echo ""
    echo "⚠️   foreman: trailer validation found issues:"
    for err in "${TRAILER_ERRORS[@]}"; do
      echo "$err"
    done
    echo ""
    echo "    These commits will fail the GitHub Actions trailer-check workflow."
    echo "    Fix with: git rebase -i ${REVIEW_BASE_REF} (then amend each commit)"
    echo "    Or bypass server-side check (not recommended): push to a non-main branch"
    echo ""
  else
    echo "    ✅  Trailer validation: all commits carry required trailers"
  fi
fi

# ── Phase 2 reviewer (soft gate by default) ───────────────────────────────────
if [[ -z "$REVIEW_BASE_REF" ]]; then
  echo "Reviewer: skipped (unable to resolve diff base; tried main and origin/main)"
elif ! command -v python3 >/dev/null 2>&1; then
  echo "Reviewer: skipped (python3 not available)"
elif [ ! -f "$REVIEWER_SCRIPT" ]; then
  echo "Reviewer: skipped (review script not available)"
elif ! REVIEW_DIFF="$(git diff "${REVIEW_BASE_REF}"...HEAD 2>/dev/null)"; then
  echo "Reviewer: skipped (unable to diff against ${REVIEW_BASE_REF})"
elif ! grep -q '[^[:space:]]' <<<"$REVIEW_DIFF"; then
  echo "Reviewer: skipped (empty diff)"
else
  :
fi

if [[ -n "${REVIEW_DIFF:-}" ]] && grep -q '[^[:space:]]' <<<"$REVIEW_DIFF"; then
  BRANCH_COMMIT_COUNT="$(git rev-list --count "${REVIEW_BASE_REF}"..HEAD 2>/dev/null || echo 0)"
  AGENT_MODELS=()
  while IFS= read -r agent_model; do
    if [[ -n "$agent_model" ]]; then
      AGENT_MODELS+=("$agent_model")
    fi
  done < <(
    git log "${REVIEW_BASE_REF}"..HEAD --format=%B | \
      sed -n 's/^Agent:[[:space:]]*//p' | sort | uniq -c | sort -rn | \
      awk '{print $2}' | head -5
  )

  PRIMARY_AGENT_MODEL="unknown"
  if [[ "${#AGENT_MODELS[@]}" -gt 0 ]]; then
    PRIMARY_AGENT_MODEL="${AGENT_MODELS[0]}"
    FIRST_AGENT_FAMILY="$(model_family "${AGENT_MODELS[0]}")"
    if [[ "$FIRST_AGENT_FAMILY" != "unknown" ]]; then
      ALL_SAME_FAMILY=true
      for agent_model in "${AGENT_MODELS[@]}"; do
        if [[ "$(model_family "$agent_model")" != "$FIRST_AGENT_FAMILY" ]]; then
          ALL_SAME_FAMILY=false
          break
        fi
      done
      if [[ "$ALL_SAME_FAMILY" == "true" ]]; then
        PRIMARY_AGENT_MODEL="$FIRST_AGENT_FAMILY"
      fi
    fi
  fi

  echo "ℹ️  foreman: detected author model '$PRIMARY_AGENT_MODEL' from ${BRANCH_COMMIT_COUNT} commits on branch"

  set +e
  REVIEWER_OUTPUT="$(
    printf '%s' "$REVIEW_DIFF" | \
      python3 "$REVIEWER_SCRIPT" --author-model "$PRIMARY_AGENT_MODEL" --branch "$CURRENT_BRANCH" - 2>&1
  )"
  REVIEWER_EXIT=$?
  set -e

  printf '%s\n' "$REVIEWER_OUTPUT"
  REVIEW_OUTPUT_PATH="$(printf '%s\n' "$REVIEWER_OUTPUT" | sed -n 's/^Review JSON:[[:space:]]*//p' | tail -1)"
  REVIEW_OUTPUT_PATH="${REVIEW_OUTPUT_PATH:-$REVIEW_JSON_PATH}"
  REVIEWED_BY_AMENDED=false

  if [ "$REVIEWER_EXIT" -eq 0 ] || [ "$REVIEWER_EXIT" -eq 1 ]; then
    REVIEWER_MODEL="$(python3 -c "
import json, sys
try:
    d = json.load(open('$REVIEW_OUTPUT_PATH'))
    print(d.get('reviewer_model', ''))
except Exception:
    sys.exit(1)
" 2>/dev/null || true)"

    if [[ -n "$REVIEWER_MODEL" ]]; then
      CURRENT_REVIEWED_BY="$(git log -1 --format=%B | sed -n 's/^Reviewed-By:[[:space:]]*//p' | head -1)"
      if [[ -z "$CURRENT_REVIEWED_BY" ]] || [[ "$CURRENT_REVIEWED_BY" == "none-yet" ]]; then
        BRANCH_COMMIT_COUNT="$(git rev-list --count "${REVIEW_BASE_REF}"..HEAD 2>/dev/null || echo 1)"
        if [[ "$BRANCH_COMMIT_COUNT" -gt 1 ]]; then
          echo "ℹ️  foreman: branch has $BRANCH_COMMIT_COUNT commits — only amending Reviewed-By on the most recent commit."
        fi

        AMEND_MSG_FILE="$(mktemp)"
        git log -1 --format=%B > "$AMEND_MSG_FILE"
        git interpret-trailers \
          --in-place \
          --if-exists replace \
          --if-missing add \
          --trailer "Reviewed-By: $REVIEWER_MODEL" \
          "$AMEND_MSG_FILE"
        git commit --amend --no-edit --no-verify -F "$AMEND_MSG_FILE" >/dev/null
        rm -f "$AMEND_MSG_FILE"
        REVIEWED_BY_AMENDED=true
        echo "✍️  foreman: amended commit — set Reviewed-By: $REVIEWER_MODEL"
      else
        echo "ℹ️  foreman: Reviewed-By already set to $CURRENT_REVIEWED_BY — not amending"
      fi
    else
      echo "⚠️  foreman: unable to parse reviewer_model from $REVIEW_OUTPUT_PATH — skipping Reviewed-By amendment"
    fi
  fi

  if [ "$REVIEWER_EXIT" -eq 1 ]; then
    # Phase 2.1 hard-gate promotion: set FOREMAN_HARD_GATE=1 to block on BLOCKER verdicts.
    # Planned default promotion: 2026-04-24 (after two-week burn-in from 2026-04-11).
    # To promote: set FOREMAN_HARD_GATE=1 in ~/.zshrc or ~/.bash_profile and record the
    # decision in DECISIONS.md with date and any false-BLOCKER evidence from the burn-in.
    if [[ "${FOREMAN_HARD_GATE:-}" == "1" ]]; then
      echo "REVIEWER VERDICT: BLOCKER — hard gate active, push blocked."
      echo "Full review: $REVIEW_OUTPUT_PATH"
      echo ""
      exit 1
    fi
    echo "REVIEWER VERDICT: BLOCKER — soft gate active, push proceeding. Set FOREMAN_HARD_GATE=1 in your shell to promote BLOCKER to a hard gate."
    echo "Full review: $REVIEW_OUTPUT_PATH"
  elif [ "$REVIEWER_EXIT" -ne 0 ]; then
    echo "Reviewer: warning review script exited with status $REVIEWER_EXIT; push proceeding."
  fi

  if [[ "$REVIEWED_BY_AMENDED" == "true" ]]; then
    # Git resolves the local source SHA for the push before running pre-push. If we amend
    # here, this push would still send the pre-amend commit. Stop now so a rerun of
    # `git push` sends the amended SHA with the updated Reviewed-By trailer.
    echo "⚠️  foreman: push stopped because Reviewed-By was amended on the last commit."
    echo "    Re-run git push to send the amended SHA."
    echo ""
    exit 1
  fi
fi

echo "✅  foreman: gate passed — push proceeding."
echo ""
exit 0
