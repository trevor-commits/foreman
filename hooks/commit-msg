#!/usr/bin/env bash
# =============================================================================
# foreman — commit-msg hook
# Enforces the foreman commit trailer schema on every non-merge commit.
#
# Required trailers (after a blank line at the end of the commit message):
#   Agent:       which tool and model wrote this (e.g. codex-5.3, claude-opus-5)
#   Thread:      session/thread ID or URL that spawned this task
#   Task:        one-line description of the actual ask
#   Verified-By: comma-separated list of checks that ran (pytest, ruff, build, etc.)
#
# Optional but encouraged:
#   Reviewed-By: the model that reviewed this diff (must differ from Agent)
#
# To bypass in a genuine emergency: git commit --no-verify
# Install: hooks/install.sh copies this to .git/hooks/commit-msg and chmod +x
# =============================================================================

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
COMMIT_SUBJECT="$(sed -n '1p' "$COMMIT_MSG_FILE")"

# ── Skip auto-generated commits ───────────────────────────────────────────────
if printf '%s\n' "$COMMIT_SUBJECT" | grep -qE '^(Merge |fixup! |squash! |WIP |wip )'; then
  exit 0
fi

# Also skip if the commit message is empty or just whitespace (git will catch it)
if [[ -z "$(echo "$COMMIT_MSG" | tr -d '[:space:]')" ]]; then
  exit 0
fi

# ── Check for required trailers ───────────────────────────────────────────────
MISSING=()

check_trailer() {
  local trailer="$1"
  # Trailers appear at the start of a line, case-insensitive, followed by a colon
  if ! printf '%s\n' "$COMMIT_MSG" | grep -qiE "^${trailer}:[[:space:]]*.+"; then
    MISSING+=("$trailer")
  fi
}

check_trailer "Agent"
check_trailer "Thread"
check_trailer "Task"
check_trailer "Verified-By"

# ── Warn if Reviewed-By is missing or set to "none-yet" ──────────────────────
REVIEWED_BY="$(printf '%s\n' "$COMMIT_MSG" | grep -iE "^Reviewed-By:" | head -1 || true)"
REVIEW_WARNING=false
if [[ -z "$REVIEWED_BY" ]] || printf '%s\n' "$REVIEWED_BY" | grep -qi "none-yet"; then
  REVIEW_WARNING=true
fi

# ── Report ────────────────────────────────────────────────────────────────────
if [ ${#MISSING[@]} -gt 0 ]; then
  echo ""
  echo "❌  foreman: commit rejected — missing required trailers"
  echo ""
  for t in "${MISSING[@]}"; do
    echo "    • ${t}:"
  done
  echo ""
  echo "    Add these trailers after a blank line at the end of your message:"
  echo ""
  echo "        Agent: <tool-model, e.g. codex-5.3 or claude-opus-5>"
  echo "        Thread: <session/thread ID or URL, or 'cowork' if from Cowork>"
  echo "        Task: <one-line description of the actual ask>"
  echo "        Verified-By: <checks that ran: pytest, ruff, mypy, build, manual, etc.>"
  echo "        Reviewed-By: <reviewer model — must differ from Agent, or 'none-yet'>"
  echo ""
  echo "    To bypass for a genuine emergency: git commit --no-verify"
  echo ""
  exit 1
fi

if [ "$REVIEW_WARNING" = true ]; then
  echo ""
  echo "⚠️   foreman: no second-model review on this commit"
  echo "    'Reviewed-By: none-yet' — remember to get a cross-model review"
  echo "    before merging. See AGENTS.md §3 for merge conditions."
  echo ""
  # Warning only — does not block the commit
fi

exit 0
